# Copy this file to .env and adjust as needed:
#   cp .env.example .env
#
# Every variable below has a working default baked into collector/config.js
# and backend/config.py - .env only needs to exist for python-dotenv/node's
# loader to find it; you do not have to set every line.

# --- Fixed branch (Riyadh) -----------------------------------------------
# These are DEFAULT values only, per the project spec. Every run verifies
# the configured branch still exists and is active via getStoreList /
# validateLocation / getNewStore before collecting anything - see README
# "Branch verification". If you change these, the very next run will
# re-verify against the new branch rather than silently trusting it.
#
# EUROMARCHE (storeId=143) - switched from RABWAH/223 when that branch was
# closed for Pickup. Among the 2026-08-06 candidates confirmed for both
# Pickup and Delivery - see README "Branch verification" and api-map.md.
KFC_CITY=Riyadh
KFC_BRANCH_NAME=EUROMARCHE
KFC_STORE_ID=143
KFC_LATITUDE=24.70453454
KFC_LONGITUDE=46.66464865
TIMEZONE=Asia/Riyadh

# --- Node collector target / pacing ---------------------------------------
KFC_BASE_URL=https://saudi.kfc.me
START_URL=https://saudi.kfc.me/en/home
HEADLESS=true
MAX_RETRIES=2
PAGE_TIMEOUT=45000
ACTION_TIMEOUT=15000
API_TIMEOUT=20000
# Delay between successive direct API calls (getProductsByCategory loop) -
# keep this modest and polite, this is the whole point of "low concurrency".
DELAY_BETWEEN_REQUESTS=700
DELAY_BETWEEN_PAGES=1500
DELAY_BETWEEN_ACTIONS=800
# Screenshots are only taken for NEW_PRODUCT / NEW_OFFER events (see README)
# - this is a hard ceiling per run as a last-resort safety valve, not the
# expected normal count.
MAX_SCREENSHOTS_PER_RUN=40

# --- robots.txt compliance -------------------------------------------------
# saudi.kfc.me/robots.txt disallows crawling *cart*, *checkout*,
# /Registration, *notification*, *forgotpassword*, *banners*. This system
# never needs any of those (menu/offer pages only for screenshots), but the
# guard stays on by default as defense-in-depth.
RESPECT_ROBOTS_TXT=true

# --- SQLite / data locations -------------------------------------------------
# These are relative to competitors/kfc/ (see competitors/kfc/backend/
# config.py's PROJECT_ROOT) - NOT the repository root - so KFC's database,
# raw responses, screenshots, and exports all stay isolated inside
# competitors/kfc/, per the multi-competitor architecture (root README.md).
# This .env file is shared by all competitors for now since these variable
# names aren't yet namespaced per-competitor; only KFC reads them today.
DB_PATH=data/database/kfc_monitor.db
RAW_DATA_DIR=data/raw
SCREENSHOTS_DIR=data/screenshots
EXPORTS_DIR=exports
LOG_DIR=data/logs

# --- Daily scheduler ---------------------------------------------------------
DAILY_RUN_TIME=06:00
ENABLE_SCHEDULER=true
# Random jitter (seconds) added to the daily run time to avoid hammering the
# site at exactly the same second every day across many independent local
# installs. Set to 0 to disable.
SCHEDULER_JITTER_SECONDS=60

# --- Burger King (competitors/burger_king/) ---------------------------------
# Namespaced with a BK_ prefix (unlike KFC's plain names above) so this
# shared .env file can hold both competitors' settings without collision -
# see competitors/burger_king/backend/config.py.
#
# Dabab Street (storeId=11474) - confirmed live via GetRestaurants to have
# mobileOrderingStatus="live", hasDelivery=true, hasTakeOut=true, with real
# priced products on both channels at verification time (2026-08-11) - see
# competitors/burger_king/research/api-map/api-map.md "Branch selection".
BK_CITY=Riyadh
BK_BRANCH_NAME=Dabab Street
BK_STORE_ID=11474
BK_LATITUDE=24.7136
BK_LONGITUDE=46.6753

BK_DB_PATH=data/database/burger_king_monitor.db
BK_RAW_DATA_DIR=data/raw
BK_SCREENSHOTS_DIR=data/screenshots
BK_EXPORTS_DIR=exports
BK_LOG_DIR=data/logs

BK_DAILY_RUN_TIME=06:30
BK_ENABLE_SCHEDULER=true

# --- Herfy (competitors/herfy/) ---------------------------------------------
# Namespaced with a HERFY_ prefix so this shared .env can hold every
# competitor's settings without collision - see competitors/herfy/
# backend/config.py and competitors/herfy/README.md "Configuration".
#
# RUH - Al Mogarazat - Eirad Plaza Mall 1073 (locationId=29696) - confirmed
# live via GET /locations/29696 to have status="active", is-open=true,
# pickup-enabled=1, delivery-enabled=1 at verification time (2026-08-11) -
# see competitors/herfy/research/api-map/api-map.md "Branch selection".
HERFY_CITY=Riyadh
HERFY_BRANCH_NAME=RUH - Al Mogarazat - Eirad Plaza Mall 1073
HERFY_LOCATION_ID=29696
HERFY_LATITUDE=24.76017
HERFY_LONGITUDE=46.717525

HERFY_DB_PATH=data/database/herfy_monitor.db
HERFY_RAW_DATA_DIR=data/raw
HERFY_SCREENSHOTS_DIR=data/screenshots
HERFY_EXPORTS_DIR=exports
HERFY_LOG_DIR=data/logs

HERFY_DAILY_RUN_TIME=06:45
HERFY_ENABLE_SCHEDULER=true

# --- Hardee's (competitors/hardees/) -----------------------------------------
# Namespaced with an HRD_ prefix so this shared .env can hold every
# competitor's settings without collision - see competitors/hardees/
# backend/config.py and competitors/hardees/README.md "Configuration".
#
# EUROMARCHE-H (storeId=24) - confirmed live via getStoreList (cmsStatus=1,
# active=1, services.del=1, services.tak=1) AND both getNewStore (PICKUP) and
# validateLocation (DELIVERY, deliverable=true) resolving back to storeId=24
# for these exact coordinates at verification time (2026-08-11) - see
# competitors/hardees/research/api-map/api-map.md "Branch selection". This is
# the same physical retail location KFC's own EUROMARCHE/143 branch uses -
# Hardee's Saudi runs on the identical Americana-operated platform as KFC.
HRD_CITY=Riyadh
HRD_BRANCH_NAME=EUROMARCHE-H
HRD_STORE_ID=24
HRD_LATITUDE=24.70452479
HRD_LONGITUDE=46.66425169

# saudi.hardees.me's own TLS certificate was found EXPIRED at verification
# time (2026-08-11, expired 2026-07-20) - a real issue on the target site's
# own infrastructure. Required true for every module that connects to it
# (Playwright bootstrap + direct HTTPS calls) - see api-map.md "Known
# limitation: expired TLS certificate".
HRD_IGNORE_TLS_ERRORS=true

HRD_DB_PATH=data/database/hardees_monitor.db
HRD_RAW_DATA_DIR=data/raw
HRD_SCREENSHOTS_DIR=data/screenshots
HRD_EXPORTS_DIR=exports
HRD_LOG_DIR=data/logs

HRD_DAILY_RUN_TIME=07:00
HRD_ENABLE_SCHEDULER=true
