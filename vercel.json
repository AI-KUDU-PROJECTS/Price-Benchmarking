{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm --prefix frontend ci",
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "includeFiles": "{bff/**,adapters/**,competitors/**/*.py,competitors/hungerstation/data/hungerstation.db*,competitors/hungerstation/data/images/**,kudu/**}",
      "excludeFiles": "{**/__pycache__/**,**/*.pyc,**/tests/**,**/data/raw/**,**/data/screenshots/**,**/data/logs/**,frontend/**,node_modules/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/health",
      "destination": "/api/index"
    },
    {
      "source": "/hungerstation-images/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/:path((?!api(?:/|$)|health$|hungerstation-images(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
